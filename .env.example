# Copy to .env. Never commit real secrets.
HP_ENV=demo                      # local | demo | test | production (demo accounts are disabled in production)
HP_WORKSPACE=pilot_br
HP_SECRET_KEY=change-me-to-a-long-random-string
HP_PILOT=3304557,3550308,3106200 # or "capitals" for the 27 state capitals
HP_WORKERS=2
HP_JOB_TIMEOUT=1800
HP_OFFLINE=0                     # 1 = no network fetches (fixture/offline mode)
# HP_MLFLOW_URI=http://mlflow:5000   # optional: mirror training runs to MLflow (the built-in registry stays authoritative)

# --- LLM analysis (Viet Nam dashboard, simulator, outbreak sandbox advisor). Leave empty for the rule-based brief.
# Admins can switch provider/model/effort or turn the AI off in Admin -> Settings -> AI analyst (keys stay here).
# HP_LLM_PROVIDER=auto            # auto | anthropic | openai
# ANTHROPIC_API_KEY=
# HP_LLM_MODEL=claude-opus-5-5    # required when using openai
# HP_LLM_EFFORT=medium            # Claude effort: low | medium | high
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Custom Claude endpoint (LiteLLM, corporate gateway, proxy) speaking the Anthropic Messages API:
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=          # Bearer token for the gateway, used when ANTHROPIC_API_KEY is empty
